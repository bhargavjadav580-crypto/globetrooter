# ==============================================================================
# GlobeTrotter Backend Environment Configuration
# ==============================================================================

# Database Connection (MongoDB)
# Options:
# 1. MongoDB Atlas (Production Cloud):
#    MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# 2. Local MongoDB Server:
#    MONGO_URL=mongodb://127.0.0.1:27017
# 3. In-Memory Mock (Development without MongoDB installed):
#    MONGO_URL=mock
MONGO_URL=mock

# Database Name
DB_NAME=trip_planner

# Connection Pool Settings (for live MongoDB/Atlas)
MONGO_TIMEOUT_MS=8000
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5

# Environment Mode: 'development' or 'production'
ENVIRONMENT=development

# Demo Login Toggle (set to false in production)
ENABLE_DEMO_LOGIN=true

# Server & Network
PORT=8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Admin Access Control (comma-separated admin email list)
ADMIN_EMAILS=admin@globetrotter.app

# Optional AI / LLM Configuration
EMERGENT_LLM_KEY=mock_key

